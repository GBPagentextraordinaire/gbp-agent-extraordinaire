---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Faq from '../../components/Faq.astro';

const page = await getEntry('pages', 'home/es');
if (!page) throw new Error('Missing content file: src/content/pages/home/es.json');
const { meta, hero, faq } = page.data;
---

<BaseLayout locale="es" metaTitle={meta.title} metaDescription={meta.description}>
  <Hero hero={hero} />
  <Faq faq={faq} />
</BaseLayout>
