---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Faq from '../components/Faq.astro';

const page = await getEntry('pages', 'home/en');
if (!page) throw new Error('Missing content file: src/content/pages/home/en.json');
const { meta, hero, faq } = page.data;
---

<BaseLayout locale="en" metaTitle={meta.title} metaDescription={meta.description}>
  <Hero hero={hero} />
  <Faq faq={faq} />
</BaseLayout>
